{
  "name": "incompatible-packages",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Show installed packages whose native modules are incompatible with the current version.",
  "keywords": [
    "native-module",
    "warning",
    "broken",
    "mismatch",
    "node"
  ],
  "repository": "https://github.com/lumine-code/incompatible-packages",
  "bugs": {
    "url": "https://github.com/lumine-code/incompatible-packages/issues"
  },
  "license": "MIT",
  "main": "./lib/main",
  "files": [
    "lib",
    "menus",
    "spec",
    "styles",
    "THIRD_PARTY_NOTICES"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "consumedServices": {
    "status-bar": {
      "versions": {
        "^2.0.0": "consumeStatusBar"
      }
    }
  },
  "deserializers": {
    "IncompatiblePackagesComponent": "deserializeIncompatiblePackagesComponent"
  },
  "dependencies": {
    "@lumine-code/etch": "github:lumine-code/etch#c415f1685f7b913b137ffbd0b3e7fa983cb24f17"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
